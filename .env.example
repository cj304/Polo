# ─────────────────────────────────────────────────────────────
# LeadCommand environment configuration
# Copy this file to `.env` and fill in real values.
# Variables prefixed VITE_ are exposed to the browser bundle.
# Everything else is server-only (Express API in /server).
# ─────────────────────────────────────────────────────────────

# App
VITE_APP_NAME=LeadCommand
# When false (default) the app runs entirely on bundled mock data and
# never calls out to external services. Flip to true once keys are set.
VITE_USE_LIVE_DATA=false

# ── Supabase (database + auth) ──────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side service role key — NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Telnyx (phone numbers, call tracking, AI voice agents) ──
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
# Connection/app the purchased numbers attach to.
TELNYX_CONNECTION_ID=
# Public base URL Telnyx will POST webhooks to (e.g. https://app.leadcommand.io)
TELNYX_WEBHOOK_BASE_URL=

# ── Stripe (invoicing + payments) ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=

# ── Resend (email notifications) ───────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@leadcommand.io

# ── Server ─────────────────────────────────────────────────
PORT=8787
